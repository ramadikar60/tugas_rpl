arent="0"/><mxCell id="p2-2" value="&lt;b&gt;Class Diagram - Aplikasi Notebook (18 kelas, 8 enumerasi)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1400" height="30" as="geometry"/></mxCell><mxCell id="p2-3" value="CD-0 = peta seluruh kelas. CD-1 s.d. CD-5 = atribut, operasi, dan relasi. Kotak abu-abu putus-putus = kelas yang digambar di diagram lain. ◆ = komposisi (◆ di sisi keseluruhan). Garis putus dengan panah «create» = dependensi." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="0" y="34" width="1500" height="40" as="geometry"/></mxCell><mxCell id="p2-4" value="CD-0: Ikhtisar Seluruh Kelas" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9a9a9a;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="1700" height="760" as="geometry"/></mxCell><mxCell id="p2-5" value="User" style="rounded=0;html=1;fillColor=#e0f2ea;strokeColor=#1b6e55;strokeWidth=2;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="150" width="150" height="34" as="geometry"/></mxCell><mxCell id="p2-6" value="Session" style="rounded=0;html=1;fillColor=#e0f2ea;strokeColor=#1b6e55;strokeWidth=2;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="130" height="34" as="geometry"/></mxCell><mxCell id="p2-7" value="ActivityLog" style="rounded=0;html=1;fillColor=#e0f2ea;strokeColor=#1b6e55;strokeWidth=2;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="150" width="130" height="34" as="geometry"/></mxCell><mxCell id="p2-8" value="Backup" style="rounded=0;html=1;fillColor=#e0f2ea;strokeColor=#1b6e55;strokeWidth=2;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="360" y="150" width="130" height="34" as="geometry"/></mxCell><mxCell id="p2-9" 