=none;dashed=1;html=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2480" y="6192" as="sourcePoint"/><mxPoint x="2480" y="6572" as="targetPoint"/></mxGeometry></mxCell><mxCell id="p5-499" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2800" y="6192" as="sourcePoint"/><mxPoint x="2800" y="6572" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p6" name="6. State Machine Diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="3200" pageHeight="7000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p6-2" value="&lt;b&gt;State Machine Diagram - Aplikasi Notebook (7 diagram status objek)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1400" height="30" as="geometry"/></mxCell><mxCell id="p6-3" value="● = state awal, ◉ = state akhir (merah = akhir gagal). Kotak hijau = state normal, merah muda = state terbatas/negatif. Label transisi: Tn event [guard] / efek (Tn sama dengan tabel pemetaan). Transisi internal ditulis di dalam kotak state. Panah merah = jalur gagal." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="0" y="34" width="2400" height="40" as="geometry"/></mxCell><mxCell id="p6-5" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="80" y="300" width="20" height="20" as="geometry"/></mxCell><mxCell id="p6-6" value="&lt;b&gt;Aktif&lt;/b&gt;&lt;hr size='1'&gt;&lt;div style='text-align:left;font-size:10px'&gt;T12 Ubah nama/foto/tema/bahasa [Data valid? = Ya] / Simpan perubahan profil&lt;br&gt;T13 Ubah password / Simpan password baru (di-hash)&lt;br&gt;T14 Reset password oleh Admin / Simpan password baru (di-hash)&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e0f2ea;strokeColor=#1b6e55;strokeWidth=2;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="220" width="380" height="136" as="geometry"/></mxCell><mxCell id="p6-7" value="&lt;b&gt;Terkunci Sementara&lt;/b&gt;&lt;hr size='1'&gt;&lt;div style='text-align:left;font-size:10px'&gt;T10 Isi username/email dan password [Akun bisa dipakai? = Tidak] / Tampilkan pesan akun nonaktif atau terkunci&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#fbebe6;strokeColor=#a33a1a;strokeWidth=2;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="220" width="400" height="76" as="geometry"/></mxCell><mxCell id="p6-8" value="&lt;b&gt;Nonaktif&lt;/b&gt;&lt;hr size='1'&gt;&lt;div style='text-align:left;font-size:10px'&gt;T11 Isi username/email dan password [Akun bisa dipakai? = Tidak] / Tampilkan pesan akun nonaktif atau terkunci&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#fbebe6;strokeColor=#a33a1a;strokeWidth=2;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="580" width="400" height="76" as="geometry"/></mxCell><mxCell id="p6-9" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1100" y="640" width="28" height="28" as="geometry"/></mxCell><mxCell id="p6-10" value="Akun Dihapus" style="text;html=1;align=center;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="670" width="150" height="20" as="geometry"/></mxCell><mxCell id="p6-11" value="T1 Isi username/email dan password [Data valid? = Ya] / Simpan akun baru (password di-hash); Tampilkan registrasi berhasil" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6-5" target="p6-6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="310"/></Array></mxGeometry></mxCell><mxCell id="p6-12" value="T2 Isi data akun (aksi buat) [Permintaan valid? = Ya] / Simpan perubahan akun" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6-5" target="p6-6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="410"/><mxPoint x="400" y="410"/></Array></mxGeometry></mxCell><mxCell id="p6-13" value="T3 Login gagal [melewati batas percobaan] / Tampilkan pesan login gagal dan catat percobaan gagal" style="endArrow=block;endFill=1;html=1;strokeColor=#c0392b;strokeWidth=1.5;fontSize=10;fontColor=#8a2a1a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;entryX=0;entryY=0.25;" edge="1" parent="1" source="p6-6" target="p6-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-14" value="T4 Masa penguncian berakhir" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" edge="1" parent="1" source="p6-7" target="p6-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-15" value="T5 Admin: edit status [Permintaan valid? = Ya] / Simpan perubahan akun (status = nonaktif)" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="p6-6" target="p6-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-16" value="T6 Admin: edit status [Permintaan valid? = Ya] / Simpan perubahan akun (status = aktif)" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.7;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="p6-8" target="p6-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-17" value="T7 Admin: hapus akun [Permintaan valid? = Ya; Admin menyetujui konfirmasi] / Simpan perubahan akun (akun dihapus)" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.9;" edge="1" parent="1" source="p6-6" target="p6-9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="360"/><mxPoint x="900" y="654"/></Array></mxGeometry></mxCell><mxCell id="p6-18" value="T8 (hapus akun, sama dengan T7)" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;" edge="1" parent="1" source="p6-7" target="p6-9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="560"/></Array></mxGeometry></mxCell><mxCell id="p6-19" value="T9 (hapus akun, sama dengan T7)" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;" edge="1" parent="1" source="p6-8" target="p6-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-20" value="SM-01: Akun Pengguna" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9a9a9a;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="1500" height="730" as="geometry"/></mxCell><mxCell id="p6-21" value="Akun dibuat lewat Registrasi atau oleh Admin, bisa terkunci sementara karena login gagal berulang, dinonaktifkan/diaktifkan Admin, dan berakhir saat dihapus. UC-01, UC-02, UC-04, UC-16." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="118" width="1460" height="36" as="geometry"/></mxCell><mxCell id="p6-23" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="1110" width="20" height="20" as="geometry"/></mxCell><mxCell id="p6-24" value="&lt;b&gt;Belum Login&lt;/b&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e0f2ea;strokeColor=#1b6e55;strokeWidth=2;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="1060" width="220" height="46" as="geometry"/></mxCell><mxCell id="p6-25" value="&lt;b&gt;Memeriksa Akun&lt;/b&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e0f2ea;strokeColor=#1b6e55;strokeWidth=2;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="1060" width="220" height="46" as="geometry"/></mxCell><mxCell id="p6-26" value="&lt;b&gt;Memverifikasi Kredensial&lt;/b&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e0f2ea;strokeColor=#1b6e55;strokeWidth=2;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="1060" width="260" height="46" as="geometry"/></mxCell><mxCell id="p6-27" value="&lt;b&gt;Sesi Aktif&lt;/b&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e0f2ea;strokeColor=#1b6e55;strokeWidth=2;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="1360" width="260" height="46" as="geometry"/></mxCell><mxCell id="p6-28" value="Buka halaman login" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6-23" target="p6-24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-29" value="T1 Isi username/email dan password" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="p6-24" target="p6-25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-30" value="T2 [Akun bisa dipakai? = Tidak] / Tampilkan pesan akun nonaktif atau terkunci" style="endArrow=block;endFill=1;html=1;strokeColor=#c0392b;strokeWidth=1.5;fontSize=10;fontColor=#8a2a1a;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" edge="1" parent="1" source="p6-25" target="p6-24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-31" value="T3 [Akun bisa dipakai? = Ya]" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6-25" target="p6-26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-32" value="T4 [Kredensial benar? = Tidak] / Tampilkan pesan login gagal dan catat percobaan gagal" style="endArrow=block;endFill=1;html=1;strokeColor=#c0392b;strokeWidth=1.5;fontSize=10;fontColor=#8a2a1a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="p6-26" target="p6-24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="980"/><mxPoint x="270" y="980"/></Array></mxGeometry></mxCell><mxCell id="p6-33" value="T5 [Kredensial benar? = Ya] / Buat sesi login; Catat aktivitas login; Tampilkan beranda sesuai peran" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6-26" target="p6-27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-34" value="T6 Pilih menu keluar / Akhiri sesi; Catat aktivitas logout; Arahkan ke halaman login.&lt;br&gt;T7 Tidak aktif melewati batas waktu / Akhiri sesi.&lt;br&gt;T8 Logout semua sesi / Akhiri seluruh sesi aktif" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="p6-27" target="p6-24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="270" y="1400"/></Array></mxGeometry></mxCell><mxCell id="p6-35" value="SM-02: Sesi Pengguna" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9a9a9a;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="890" width="1500" height="590" as="geometry"/></mxCell><mxCell id="p6-36" value="Status sesi dari halaman login sampai sesi berakhir. Alur sama untuk User, Viewer, dan Admin; hanya beranda yang berbeda. UC-02, UC-03." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="918" width="1460" height="36" as="geometry"/></mxCell><mxCell id="p6-38" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="1780" width="20" height="20" as="geometry"/></mxCell><mxCell id="p6-39" value="&lt;b&gt;Aktif&lt;/b&gt;&lt;hr size='1'&gt;&lt;div style='text-align:left;font-size:10px'&gt;T11 Tulis isi (aksi edit) [Permintaan valid? = Ya] / Simpan catatan (FR-009 simpan otomatis)&lt;br&gt;T12 Lihat &amp; restore versi / Pulihkan catatan ke versi tertentu&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e0f2ea;strokeColor=#1b6e55;strokeWidth=2;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="1710" width="400" height="106" as="geometry"/></mxCell><mxCell id="p6-40" value="&lt;b&gt;Terkunci&lt;/b&gt;&lt;hr size='1'&gt;&lt;div style='text-align:left;font-size:10px'&gt;T13 Buka catatan [verifikasi tambahan berhasil] / Tampilkan catatan dalam mode baca saja&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e0f2ea;strokeColor=#1b6e55;strokeWidth=2;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="1590" width="380" height="76" as="geometry"/></mxCell><mxCell id="p6-41" value="&lt;b&gt;Diarsipkan&lt;/b&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e0f2ea;strokeColor=#1b6e55;strokeWidth=2;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="1890" width="380" height="46" as="geometry"/></mxCell><mxCell id="p6-42" value="&lt;b&gt;Di Trash&lt;/b&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#fbebe6;strokeColor=#a33a1a;strokeWidth=2;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="2020" width="400" height="46" as="geometry"/></mxCell><mxCell id="p6-43" value="" style="ellipse;html=1;shape=endState;fillColor=#c0392b;strokeColor=#c0392b;" vertex="1" parent="1"><mxGeometry x="1060" y="2150" width="28" height="28" as="geometry"/></mxCell><mxCell id="p6-44" value="Terhapus Permanen" style="text;html=1;align=center;fontSize=11;fontStyle=1;fontColor=#a33a1a;" vertex="1" parent="1"><mxGeometry x="1000" y="2180" width="150" height="20" as="geometry"/></mxCell><mxCell id="p6-45" value="T1 Tulis isi atau pilih catatan (aksi buat) [Permintaan valid? = Ya] / Simpan catatan; Tampilkan catatan terbaru" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;" edge="1" parent="1" source="p6-38" target="p6-39"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="100" y="1760"/></Array></mxGeometry></mxCell><mxCell id="p6-46" value="T2 Pilih berkas (MD, TXT, HTML, DOCX, PDF) [Format didukung? = Ya] / Konversi isi berkas menjadi catatan; Simpan catatan hasil impor" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;" edge="1" parent="1" source="p6-38" target="p6-39"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="100" y="1870"/></Array></mxGeometry></mxCell><mxCell id="p6-47" value="T3 Kunci catatan" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="p6-39" target="p6-40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-48" value="T4 Verifikasi tambahan berhasil / Buka kunci catatan" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.9;entryX=1;entryY=0.4;" edge="1" parent="1" source="p6-40" target="p6-39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-49" value="T5 Arsipkan catatan" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.6;entryX=0;entryY=0.3;" edge="1" parent="1" source="p6-39" target="p6-41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-50" value="T6 Keluarkan dari arsip" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;entryX=1;entryY=0.9;" edge="1" parent="1" source="p6-41" target="p6-39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-51" value="T7 Hapus catatan [Permintaan valid? = Ya] / Simpan catatan (dipindahkan ke Trash)" style="endArrow=block;endFill=1;html=1;strokeColor=#c0392b;strokeWidth=1.5;fontSize=10;fontColor=#8a2a1a;labelBackgroundColor=#ffffff;exitX=0.3;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="p6-39" target="p6-42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-52" value="T8 Restore dari Trash [masih dalam periode retensi]" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.7;exitY=0;entryX=0.7;entryY=1;" edge="1" parent="1" source="p6-42" target="p6-39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-53" value="T9 Hapus permanen [User menyetujui konfirmasi]&lt;br&gt;T10 Periode retensi berakhir" style="endArrow=block;endFill=1;html=1;strokeColor=#c0392b;strokeWidth=1.5;fontSize=10;fontColor=#8a2a1a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;" edge="1" parent="1" source="p6-42" target="p6-43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-54" value="SM-03: Catatan" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9a9a9a;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="1520" width="1500" height="730" as="geometry"/></mxCell><mxCell id="p6-55" value="Catatan dibuat atau diimpor, dipakai/diedit, bisa dikunci atau diarsipkan, masuk Trash saat dihapus, lalu dipulihkan atau dihapus permanen. UC-06, UC-13." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="1548" width="1460" height="36" as="geometry"/></mxCell><mxCell id="p6-57" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="2480" width="20" height="20" as="geometry"/></mxCell><mxCell id="p6-58" value="&lt;b&gt;Pending&lt;/b&gt;&lt;hr size='1'&gt;&lt;div style='text-align:left;font-size:10px'&gt;T5 Isi checklist/jatuh tempo/prioritas (status tetap pending) [Permintaan valid? = Ya] / Simpan task&lt;br&gt;T6 Atur reminder [task mendekati jatuh tempo] / Ingatkan User&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e0f2ea;strokeColor=#1b6e55;strokeWidth=2;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="2420" width="440" height="106" as="geometry"/></mxCell><mxCell id="p6-59" value="&lt;b&gt;Completed&lt;/b&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e0f2ea;strokeColor=#1b6e55;strokeWidth=2;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="2420" width="300" height="46" as="geometry"/></mxCell><mxCell id="p6-60" value="T1 Isi checklist, jatuh tempo, prioritas, status (aksi buat) [Permintaan valid? = Ya] / Simpan task; Perbarui daftar dan dashboard task&lt;br&gt;T2 Buat task dari catatan" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0;entryY=0.2;" edge="1" parent="1" source="p6-57" target="p6-58"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="50" y="2460"/><mxPoint x="300" y="2460"/></Array></mxGeometry></mxCell><mxCell id="p6-61" value="T3 Ubah status = completed [Permintaan valid? = Ya] / Simpan task; Perbarui daftar dan dashboard task" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="p6-58" target="p6-59"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-62" value="T4 Ubah status = pending [Permintaan valid? = Ya] / Simpan task; Perbarui daftar dan dashboard task" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" edge="1" parent="1" source="p6-59" target="p6-58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-63" value="SM-04: Task" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9a9a9a;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="2290" width="1500" height="330" as="geometry"/></mxCell><mxCell id="p6-64" value="Status task minimal pending dan completed (FR-062). SRS tidak menyebut penghapusan task, sehingga tidak ada state akhir. UC-09." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="2318" width="1460" height="36" as="geometry"/></mxCell><mxCell id="p6-66" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="2880" width="20" height="20" as="geometry"/></mxCell><mxCell id="p6-67" valu