y"/></mxCell><mxCell id="p3-5" value="Snapshot: Budi sedang login dan punya sesi aktif. Andi gagal login berulang sehingga terkunci sementara. Dewi dinonaktifkan Admin. Ayu (Admin) dan Rina (Viewer) dibuat Admin; Agus dan Siti adalah User aktif." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="118" width="1450" height="34" as="geometry"/></mxCell><mxCell id="p3-6" value="budi : User" style="swimlane;fontStyle=5;align=center;verticalAlign=middle;horizontal=1;startSize=28;html=1;fillColor=#e0f2ea;strokeColor=#1b6e55;strokeWidth=2;fontSize=13;collapsible=0;marginBottom=0;" vertex="1" parent="1"><mxGeometry x="260" y="170" width="250" height="100" as="geometry"/></mxCell><mxCell id="p3-7" value="username = &quot;budi&quot;&lt;br&gt;role = USER&lt;br&gt;&lt;b&gt;&lt;font color='#1b6e55'&gt;status = AKTIF&lt;/font&gt;&lt;/b&gt;&lt;br&gt;failedLoginCount = 0" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;html=1;fontSize=11;" vertex="1" parent="p3-6"><mxGeometry x="0" y="28" width="250" height="72" as="geometry"/></mxCell><mxCell id="p3-8" value="andi : User" style="swimlane;fontStyle=5;align=center;verticalAlign=middle;horizontal=1;startSize=28;html=1;fillColor=#fbebe6;strokeColor=#a33a1a;strokeWidth=2;fontSize=13;collapsible=0;marginBottom=0;" vertex="1" parent="1"><mxGeometry x="700" y="170" width="260" height="100" as="geometry"/></mxCell><mxCell id="p3-9" value="username = &quot;andi&quot;&lt;br&gt;role = USER&lt;br&gt;&lt;b&gt;&lt;font color='#a33a1a'&gt;status = TERKUNCI_SEMENTARA&lt;/font&gt;&lt;/b&gt;&lt;br&gt;failedLoginCount = 5" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;html=1;fontSize=11;" vertex="1" parent="p3-8"><mxGeometry x="0" y="28" width="260" height="72" as="geometry"/></mxCell><mxCell id="p3-10" value="dewi : User" style="swimlane;fontStyle=5;align=center;verticalAlign=middle;h