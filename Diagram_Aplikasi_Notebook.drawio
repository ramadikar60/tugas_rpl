tan" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6-67" target="p6-68"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-75" value="T3 [Proses berhasil? = Tidak] / Tampilkan pesan gagal dan tawarkan coba lagi" style="endArrow=block;endFill=1;html=1;strokeColor=#c0392b;strokeWidth=1.5;fontSize=10;fontColor=#8a2a1a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;" edge="1" parent="1" source="p6-67" target="p6-69"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-76" value="T4 Hapus lampiran [Proses berhasil? = Ya] / Perbarui daftar lampiran di catatan" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6-68" target="p6-71"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-77" value="SM-05: Lampiran (Attachment)" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9a9a9a;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="2660" width="1500" height="540" as="geometry"/></mxCell><mxCell id="p6-78" value="Lampiran diunggah dan diproses (validasi tipe/ukuran), tersimpan, lalu bisa diunduh, diganti namanya, dipratinjau, atau dihapus. UC-07." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="2688" width="1460" height="36" as="geometry"/></mxCell><mxCell id="p6-80" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="3470" width="20" height="20" as="geometry"/></mxCell><mxCell id="p6-81" value="&lt;b&gt;Pribadi&lt;/b&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e0f2ea;strokeColor=#1b6e55;strokeWidth=2;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="130" y="3430" width="200" height="46" as="geometry"/></mxCell><mxCell id="p6-82" value="&lt;b&gt;Memeriksa Penerima&lt;/b&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e0f2ea;strokeColor=#1b6e55;strokeWidth=2;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="3430" width="240" height="46" as="geometry"/></mxCell><mxCell id="p6-83" value="&lt;b&gt;Dibagikan: Izin Viewer&lt;/b&gt;&lt;hr size='1'&gt;&lt;div style='text-align:left;font-size:10px'&gt;T9 Pilih catatan / Tampilkan catatan dalam mode baca saja&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e0f2ea;strokeColor=#1b6e55;strokeWidth=2;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="3310" width="400" height="76" as="geometry"/></mxCell><mxCell id="p6-84" value="&lt;b&gt;Dibagikan: Izin Editor&lt;/b&gt;&lt;hr size='1'&gt;&lt;div style='text-align:left;font-size:10px'&gt;T10 Pilih catatan / Tampilkan catatan sesuai izin akses (dapat diedit)&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e0f2ea;strokeColor=#1b6e55;strokeWidth=2;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="3580" width="400" height="76" as="geometry"/></mxCell><mxCell id="p6-85" value="&lt;b&gt;Tautan Berbagi Aktif&lt;/b&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e0f2ea;strokeColor=#1b6e55;strokeWidth=2;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="130" y="3730" width="260" height="46" as="geometry"/></mxCell><mxCell id="p6-86" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="620" y="3760" width="28" height="28" as="geometry"/></mxCell><mxCell id="p6-87" value="Tautan Dinonaktifkan" style="text;html=1;align=center;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="3790" width="150" height="20" as="geometry"/></mxCell><mxCell id="p6-88" value="" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6-80" target="p6-81"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-89" value="T1 Pilih pengguna penerima" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="p6-81" target="p6-82"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-90" value="T2 [Penerima valid? = Tidak] / Tampilkan pesan penerima tidak valid" style="endArrow=block;endFill=1;html=1;strokeColor=#c0392b;strokeWidth=1.5;fontSize=10;fontColor=#8a2a1a;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" edge="1" parent="1" source="p6-82" target="p6-81"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-91" value="T3 [Penerima valid? = Ya; izin = Viewer] / Simpan pengaturan berbagi; Catat aktivitas berbagi" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="p6-82" target="p6-83"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-92" value="T4 [Penerima valid? = Ya; izin = Editor] / Simpan pengaturan berbagi; Catat aktivitas berbagi" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;entryX=0;entryY=0.3;" edge="1" parent="1" source="p6-82" target="p6-84"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-93" value="T5 Ubah izin menjadi Editor / Catat perubahan izin" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="p6-83" target="p6-84"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-94" value="T6 Ubah izin menjadi Viewer / Catat perubahan izin" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.2;exitY=0;entryX=0.2;entryY=1;" edge="1" parent="1" source="p6-84" target="p6-83"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-95" value="T7 Buat link berbagi" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6-81" target="p6-85"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-96" value="T8 Pemilik menonaktifkan tautan" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6-85" target="p6-86"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-97" value="SM-06: Status Berbagi Konten" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9a9a9a;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="3240" width="1500" height="630" as="geometry"/></mxCell><mxCell id="p6-98" value="Status berbagi catatan/folder: pribadi, diperiksa penerimanya, dibagikan dengan izin Viewer atau Editor, atau lewat tautan yang bisa dinonaktifkan. UC-10, UC-15." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="3268" width="1460" height="36" as="geometry"/></mxCell><mxCell id="p6-100" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="30" y="4140" width="20" height="20" as="geometry"/></mxCell><mxCell id="p6-101" value="&lt;b&gt;Sedang Dibuat&lt;/b&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e0f2ea;strokeColor=#1b6e55;strokeWidth=2;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="130" y="4100" width="220" height="46" as="geometry"/></mxCell><mxCell id="p6-102" value="&lt;b&gt;Tersedia&lt;/b&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e0f2ea;strokeColor=#1b6e55;strokeWidth=2;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="4100" width="220" height="46" as="geometry"/></mxCell><mxCell id="p6-103" value="&lt;b&gt;Menunggu Konfirmasi Restore&lt;/b&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e0f2ea;strokeColor=#1b6e55;strokeWidth=2;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="990" y="4000" width="300" height="46" as="geometry"/></mxCell><mxCell id="p6-104" value="&lt;b&gt;Sedang Dipulihkan&lt;/b&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e0f2ea;strokeColor=#1b6e55;strokeWidth=2;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="990" y="4280" width="300" height="46" as="geometry"/></mxCell><mxCell id="p6-105" value="" style="ellipse;html=1;shape=endState;fillColor=#c0392b;strokeColor=#c0392b;" vertex="1" parent="1"><mxGeometry x="220" y="4380" width="28" height="28" as="geometry"/></mxCell><mxCell id="p6-106" value="Backup Gagal" style="text;html=1;align=center;fontSize=11;fontStyle=1;fontColor=#a33a1a;" vertex="1" parent="1"><mxGeometry x="160" y="4410" width="150" height="20" as="geometry"/></mxCell><mxCell id="p6-107" value="T1 Jalankan backup manual / Kumpulkan dan simpan data pengguna" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6-100" target="p6-101"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-108" value="T2 [Backup berhasil? = Ya] / Tampilkan backup baru di daftar backup" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6-101" target="p6-102"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-109" value="T3 [Backup berhasil? = Tidak] / Tampilkan pesan backup gagal" style="endArrow=block;endFill=1;html=1;strokeColor=#c0392b;strokeWidth=1.5;fontSize=10;fontColor=#8a2a1a;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;" edge="1" parent="1" source="p6-101" target="p6-105"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-110" value="T4 Pilih backup yang akan dipulihkan / Tampilkan konfirmasi restore" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="p6-102" target="p6-103"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-111" value="T5 Jawab konfirmasi [User setuju? = Tidak] / Batalkan restore" style="endArrow=block;endFill=1;html=1;strokeColor=#c0392b;strokeWidth=1.5;fontSize=10;fontColor=#8a2a1a;labelBackgroundColor=#ffffff;exitX=0;exitY=0.9;entryX=1;entryY=0.1;" edge="1" parent="1" source="p6-103" target="p6-102"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-112" value="T6 Jawab konfirmasi [User setuju? = Ya] / Pulihkan data dari backup" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6-103" target="p6-104"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-113" value="T7 [Restore berhasil? = Ya] / Tampilkan hasil restore" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.3;entryX=1;entryY=0.8;" edge="1" parent="1" source="p6-104" target="p6-102"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-114" value="T8 [Restore berhasil? = Tidak] / Tampilkan pesan restore gagal" style="endArrow=block;endFill=1;html=1;strokeColor=#c0392b;strokeWidth=1.5;fontSize=10;fontColor=#8a2a1a;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;entryX=0.7;entryY=1;" edge="1" parent="1" source="p6-104" target="p6-102"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p6-115" value="SM-07: Backup Data" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9a9a9a;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="3910" width="1500" height="540" as="geometry"/></mxCell><mxCell id="p6-116" value="Backup dibuat manual, tersedia, lalu bisa dipakai restore setelah User menyetujui konfirmasi. Restore tidak menghapus backup, jadi backup kembali Tersedia apa pun hasilnya. UC-14." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="3938" width="1460" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="7. Deployment Diagram"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="3000" pageHeight="2600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p7-2" value="&lt;b&gt;Deployment Diagram - Aplikasi Notebook (DD-1 dan DD-2)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1400" height="30" as="geometry"/></mxCell><mxCell id="p7-3" value="DD-1: Penyebaran Lengkap (5 node, 7 artifact, 4 jalur komunikasi)" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#9a9a9a;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="1800" height="900" as="geometry"/></mxCell><mxCell id="p7-4" value="&lt;font style='font-size:10px;color:#555'&gt;&amp;laquo;device&amp;raquo;&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:13px'&gt;Perangkat Pengguna&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555'&gt;komputer, laptop, atau tablet&lt;br&gt;Aktor: User, Viewer, Admin&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=22;fillColor=#f7f6f1;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="500" height="780" as="geometry"/></mxCell><mxCell id="p7-5" value="&lt;font style='font-size:10px;color:#555'&gt;&amp;laquo;execution environment&amp;raquo;&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:13px'&gt;Web browser modern&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555'&gt;Chrome, Firefox, Edge, Safari&lt;/font&gt;" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=14;fillColor=#e0f2ea;strokeColor=#1b6e55;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=2;fontSize=12;" vertex="1" parent="p7-4"><mxGeometry x="30" y="130" width="420" height="600" as="geometry"/></mxCell><mxCell id="p7-6" value="&lt;font style='font-size:10px;color:#555'&gt;&amp;laquo;artifact&amp;raquo;&lt;/font&gt;&lt;br&gt;&lt;b style='font-size:13px'&gt;frontend&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px;color:#555'&gt;HTML, CSS, JavaScript murni (tanpa framework SPA), editor Quill.js.&lt;br&gt;Halaman: Login, editor, Task, berbagi, panel admin&lt;/font&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#1b6e55;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="p7-5"><mxGeometry x="30" y="120" width="350" height="130" as="geometry"/></mxCell><mxCell id="p7-7" value="&lt;font style='font-size:10px;color:#555'&gt;&